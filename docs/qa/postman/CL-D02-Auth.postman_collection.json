    {
      "name": "02 PENDING BE D02 integration",
      "description": "Proposed DTO/status assumptions must be reviewed with BE. Signed expired/wrong-signature fixtures and disabled/other-account fixtures are externally provisioned on isolated QA only. Missing fixture requests are skipped, never counted PASS.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get(\"runAuthTests\") !== \"true\") { pm.execution.skipRequest(); }",
              "if (!pm.variables.get(\"qaEmail\")) {",
              "  pm.variables.set(\"qaEmail\", \"d02-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.test\");",
              "  pm.variables.set(\"qaPassword\", \"Qa!\" + pm.variables.replaceIn(\"{{$guid}}\") + \"aA9\");",
              "}"
            ]
          }
        }
      ],
