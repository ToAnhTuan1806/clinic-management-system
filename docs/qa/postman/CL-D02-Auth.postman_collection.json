{
  "info": {
    "name": "Clinic CL-D02-DB Auth Security QA",
    "description": "Only folder 01 is executable against D01 scaffold. Folder 02 is PENDING until BE D02 contract/integration. All state-changing requests require explicit opt-in on a disposable QA backend. Never run against shared Clinic/SmartExpense. No real credentials are stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "runAuthTests",
      "value": "false"
    },
    {
      "key": "malformedToken",
      "value": "not-a-jwt"
    },
    {
      "key": "disabledEmail",
      "value": ""
    },
    {
      "key": "disabledPassword",
      "value": ""
    },
    {
      "key": "wrongSignatureToken",
      "value": ""
    },
    {
      "key": "expiredToken",
      "value": ""
    },
    {
      "key": "otherUserId",
      "value": ""
    },
    {
      "key": "patientUserId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let body; try { body=pm.response.json(); } catch (_) { body=null; }",
          "function safeKeys(x) { if (!x || typeof x !== \"object\") return true; return Object.keys(x).every(k => ![\"password\",\"passwordhash\"].includes(k.replace(/_/g,\"\").toLowerCase()) && safeKeys(x[k])); }",
          "pm.test(\"No password or passwordHash fields\", function () { pm.expect(safeKeys(body)).to.eql(true); });",
          "const password=pm.variables.get(\"qaPassword\");",
          "if (password) pm.test(\"No echoed password\", function () { pm.expect(pm.response.text().includes(password)).to.eql(false); });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Available scaffold",
      "description": "Boundary tests only. A 401 here does not prove JWT validation or role enforcement.",
      "item": [
        {
          "name": "SCF-01 Public health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test(\"Liveness envelope\", function () { pm.expect(pm.response.json()).to.eql({data:{status:\"UP\"}}); });"
                ]
              }
            }
          ]
        },
