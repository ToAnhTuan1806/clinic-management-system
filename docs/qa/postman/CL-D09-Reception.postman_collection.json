                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedVersion\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/appointments/{{targetAppointmentId}}/confirmation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "appointments", "{{targetAppointmentId}}", "confirmation"]
            }
          },
          "response": []
        },
        {
