              "pm.test('Expected lifecycle and version', () => { pm.expect(d.status).to.eql('COMPLETED'); pm.expect(d.version).to.eql(2); });",
              "pm.test('Completed clinical data and metadata', () => { pm.expect(d.notes).to.eql('Synthetic notes D10'); pm.expect(d.completedAt).to.be.a('string'); pm.expect(d.completedBy).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
