        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/medical-records/by-appointment/{{lookupDraftAppointmentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No secrets or stack traces', () => pm.expect(pm.response.text()).not.to.match(/passwordHash|password_hash|stackTrace/i));",
              "const d=pm.response.json().data;",
              "pm.test('No-store response', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));",
              "pm.test('Correct appointment and record identity', () => { pm.expect(d.appointmentId).to.eql(pm.variables.get('lookupDraftAppointmentId')); pm.expect(d.id).to.eql(pm.variables.get('lookupDraftRecordId')); });",
              "pm.test('Expected lifecycle and version', () => { pm.expect(d.status).to.eql('IN_PROGRESS'); pm.expect(d.version).to.eql(1); });",
              "pm.test('Exact metadata keys only', () => pm.expect(Object.keys(d).sort()).to.deep.eql(['id','appointmentId','doctorId','patientId','status','createdBy','completedBy','completedAt','createdAt','updatedAt','version'].sort()));",
              "pm.test('No clinical markers leaked', () => pm.expect(pm.response.text()).not.to.include('Synthetic lookup'));"
            ]
          }
        }
      ]
    },
