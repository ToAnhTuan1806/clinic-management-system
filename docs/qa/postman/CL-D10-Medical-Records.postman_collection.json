        "url": "{{baseUrl}}/api/v1/medical-records/{{draftRecordId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedVersion\": 0,\n  \"symptoms\": \"Synthetic symptoms D10\",\n  \"diagnosis\": \"Synthetic diagnosis D10\",\n  \"notes\": \"Synthetic notes D10\",\n  \"conclusion\": \"Synthetic conclusion D10\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No credentials or stack traces', () => pm.expect(pm.response.text()).not.to.match(/passwordHash|password_hash|stackTrace/i));",
              "const d = pm.response.json().data;",
              "pm.test('No-store response', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));",
              "pm.test('String IDs', () => pm.expect(d.id).to.be.a('string'));",
              "pm.test('All four fields persisted', () => { pm.expect(d.version).to.eql(1); ['symptoms','diagnosis','notes','conclusion'].forEach(k => pm.expect(d[k]).to.eql('Synthetic '+k+' D10')); });"
            ]
          }
        }
      ]
    },
