{
  "info": {
    "name": "CL-D10 FR-09 Medical Record QA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Real D10 DTO. POST creates an empty draft with appointmentId only. PATCH supplies clinical fields and integer expectedVersion. Sequential run captures returned IDs in local variables and asserts versions 0, 1, 2. Inject synthetic QA tokens in memory; never export credentials. Run only against a new isolated loopback QA runtime. Database failure injection and concurrent requests are covered by the isolated API runner."
  },
  "variable": [
    {
      "key": "assignedDoctorToken",
      "value": ""
    },
    {
      "key": "otherDoctorToken",
      "value": ""
    },
    {
      "key": "ownerPatientToken",
      "value": ""
    },
    {
      "key": "otherPatientToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "receptionistToken",
      "value": ""
    },
    {
      "key": "draftRecordId",
      "value": ""
    },
    {
      "key": "completedRecordId",
      "value": ""
    },
    {
      "key": "uncompletedRecordId",
      "value": ""
    },
    {
      "key": "checkedInAppointmentId",
      "value": ""
    },
    {
      "key": "pendingAppointmentId",
      "value": ""
    },
    {
      "key": "confirmedAppointmentId",
      "value": ""
    },
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "enableD10",
      "value": "false"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.variables.get('enableD10') !== 'true') pm.execution.skipRequest();",
          "if (!/^http:\\/\\/(127\\.0\\.0\\.1|localhost):[0-9]+$/.test(pm.variables.get('baseUrl'))) pm.execution.skipRequest();"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Anonymous read rejected",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/medical-records/{{uncompletedRecordId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('No credentials or stack traces', () => pm.expect(pm.response.text()).not.to.match(/passwordHash|password_hash|stackTrace/i));",
              "pm.test('No clinical content in error', () => pm.expect(pm.response.text()).not.to.match(/Synthetic symptoms D10|Synthetic diagnosis D10|Synthetic notes D10|Synthetic conclusion D10/));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create CHECKED_IN draft",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{assignedDoctorToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/medical-records",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appointmentId\": \"{{checkedInAppointmentId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('No credentials or stack traces', () => pm.expect(pm.response.text()).not.to.match(/passwordHash|password_hash|stackTrace/i));",
              "const d = pm.response.json().data;",
              "pm.test('No-store response', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));",
              "pm.test('String IDs', () => pm.expect(d.id).to.be.a('string'));",
              "pm.variables.set('draftRecordId', d.id);",
              "pm.test('Draft started examination', () => { pm.expect(d.status).to.eql('IN_PROGRESS'); pm.expect(d.version).to.eql(0); pm.expect(d.symptoms).to.eql(null); });"
            ]
          }
        }
      ]
    },
