# Backend origin, for example http://127.0.0.1:8080 (without /api/v1).
# Configure explicitly for your environment. Never put secrets in VITE_*.
VITE_API_BASE_URL=
# Development QA only. Never enables mocked auth in a production build.
VITE_AUTH_MOCK=false
# Development UI QA only; synthetic directory in memory. Never a real API adapter.
VITE_DIRECTORY_MOCK=false
# D10 preview uses same-origin synthetic Playwright responses and requires VITE_AUTH_MOCK=true.
VITE_EXAMINATION_MOCK=false
# D11 synthetic UI preview, requires VITE_AUTH_MOCK=true.
VITE_HISTORY_MOCK=false
# D12 synthetic prescription UI preview, requires VITE_AUTH_MOCK=true.
VITE_PRESCRIPTION_MOCK=false
# D13 verified with MySQL V12. Enabled when unset; false explicitly disables D13 for maintenance.
# No D13 mock implementation is shipped in the app.
VITE_D13_API_READY=true
# Optional: Google OAuth Web Client ID for patient Google Sign-In (public ID only, never secrets).
VITE_GOOGLE_CLIENT_ID=
