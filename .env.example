# Clinic D01 local development only. No real credentials belong in this file.
# Copy to .env.clinic.local without overwriting an existing file; fill locally.
# Empty passwords deliberately make Compose fail until configured.
CLINIC_MYSQL_ROOT_PASSWORD=
CLINIC_MYSQL_PASSWORD=
# Host loopback only. Change this if another application already uses 3307.
CLINIC_MYSQL_PORT=3307
